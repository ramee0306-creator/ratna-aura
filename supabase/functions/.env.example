# Server secrets for Supabase Edge Functions.
# Copy this file to supabase/functions/.env for local testing — that copy is git-ignored.
# For the live server, set them with:  npx supabase secrets set --env-file supabase/functions/.env
#
# 32 random bytes, base64. Create one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# KEEP A SAFE COPY (e.g. in a password manager). If this key is lost, saved birth data cannot be read.
DATA_ENCRYPTION_KEY=
