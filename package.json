{
  "name": "ratna-aura",
  "version": "0.1.0",
  "private": true,
  "description": "Ratna Aura - Vedic astrology + numerology app by VELQORA STUDIOS",
  "workspaces": [
    "app",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start --workspace app",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspace app",
    "lint": "npm run lint --workspace app",
    "check": "npm run typecheck && npm run lint && npm test",
    "make-icons": "node scripts/make-icons.mjs",
    "bundle-functions": "node scripts/bundle-functions.mjs",
    "sync-shared": "node scripts/sync-shared.mjs",
    "build-cities": "node scripts/build-cities.mjs",
    "sync-languages": "node scripts/sync-languages.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@fusionstrings/swiss-eph": "^0.1.1",
    "@photostructure/tz-lookup": "^11.7.0",
    "all-the-cities": "^3.1.0",
    "cities.json": "^1.1.65",
    "sharp": "^0.35.5",
    "vitest": "^5.0.5"
  }
}
