# App settings. Copy this file to app/.env and fill in the values (app/.env is git-ignored).
#
# Both values are PUBLIC by design and safe inside the app.
# NEVER put the Supabase "secret" / "service_role" key here.
# Find them in Supabase: Project Settings -> API Keys
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set to 1 to click through the screens WITHOUT a server (only works while the two values above are empty).
EXPO_PUBLIC_DEMO_MODE=0
